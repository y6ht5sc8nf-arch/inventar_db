{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nachlass-inventar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Oberfläche und API laufen auf derselben Adresse: statische Dateien aus ./public,
  // alles unter /api/* geht an den Worker. Eine Access-Anwendung schützt beides.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventar",
      // Wird nach `wrangler d1 create inventar` eingetragen.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "nachlass-fotos" }
  ],

  // Abholung der Batch-Ergebnisse (Auswertung über Nacht).
  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    // Team-Domain von Cloudflare Zero Trust, z. B. "meinteam.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "",
    // "Application Audience (AUD) Tag" der Access-Anwendung
    "ACCESS_AUD": ""
  }

  // Secrets (nur per `wrangler secret put`, nie hier eintragen):
  //   ANTHROPIC_API_KEY  – Schlüssel für die Anthropic-API
  //   ALLOWED_EMAILS     – die zwei erlaubten Adressen, durch Komma getrennt
}
