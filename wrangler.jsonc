{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nachlass-inventar",
  "account_id": "6ead2a9eb4a0bb5796697ac97882fe07",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Vorschau-Adressen abschalten: Access schützt nur die Hauptadresse.
  "preview_urls": false,

  // Oberfläche und API laufen auf derselben Adresse. Die Dateien aus ./public werden
  // beim Bauen in den Worker gepackt (scripts/bundle-public.mjs) und von ihm ausgeliefert.
  // Eine Access-Anwendung schützt beides.
  "build": { "command": "node scripts/bundle-public.mjs" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventar",
      "database_id": "f54ec218-a754-45fa-b8aa-b4a3e3a98448",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "nachlass-fotos" }
  ],

  // Abholung der Batch-Ergebnisse (Auswertung über Nacht).
  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    // Team-Domain von Cloudflare Zero Trust, z. B. "meinteam.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "quiet-tooth-3c66.cloudflareaccess.com",
    // "Application Audience (AUD) Tag" der Access-Anwendung
    "ACCESS_AUD": "3a61adfdf0bfa9e5aa18fb9866b73f675fe566074724a4b711152f78b839e6dd"
  }

  // Secrets (nur per `wrangler secret put`, nie hier eintragen):
  //   ANTHROPIC_API_KEY  – Schlüssel für die Anthropic-API
  //   ALLOWED_EMAILS     – die zwei erlaubten Adressen, durch Komma getrennt
}
